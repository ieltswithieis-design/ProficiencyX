{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LingoFi IELTS Test Upload",
  "description": "Canonical LingoFi schema. Legacy q/answer records are also accepted and normalized.",
  "type": "object",
  "required": ["section", "title"],
  "properties": {
    "section": {"type": "string", "enum": ["reading", "listening", "writing", "speaking", "full"]},
    "title": {"type": "string", "minLength": 1},
    "difficulty": {"type": "string", "enum": ["Standard Academic", "High Stakes Academic", "Official Cambridge Simulation"]},
    "passages": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
    "parts": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "required": ["part", "script", "questions"],
        "properties": {
          "part": {"type": "integer", "minimum": 1, "maximum": 4},
          "script": {"type": "string", "minLength": 1},
          "audioUrl": {"type": "string", "format": "uri"},
          "audioDurationSeconds": {"type": "number", "minimum": 0},
          "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/question"}}
        }
      }
    },
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/question"}},
    "task1Prompt": {"type": "string"},
    "task2Prompt": {"type": "string"},
    "task1": {"type": "string"},
    "task2": {"type": "string"},
    "task1Type": {"type": "string"},
    "task1_type": {"type": "string"},
    "task1Instructions": {"type": "string"},
    "task2Instructions": {"type": "string"},
    "responseRequirements": {
      "type": "object",
      "properties": {
        "task1MinimumWords": {"type": "integer", "minimum": 1},
        "task2MinimumWords": {"type": "integer", "minimum": 1},
        "task1Minutes": {"type": "integer", "minimum": 1},
        "task2Minutes": {"type": "integer", "minimum": 1},
        "totalMinutes": {"type": "integer", "minimum": 1}
      }
    },
    "speakingParts": {
      "type": "object",
      "properties": {
        "part1": {"type": "array", "items": {"type": "string"}},
        "part2": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["cueCard"], "properties": {"cueCard": {"type": "string"}, "preparationSeconds": {"type": "integer", "minimum": 0}, "speakingSeconds": {"type": "integer", "minimum": 0}}}]},
        "part3": {"type": "array", "items": {"type": "string"}}
      }
    },
    "part1": {"type": "array", "items": {"type": "string"}},
    "part2": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["cueCard"], "properties": {"cueCard": {"type": "string"}, "preparationSeconds": {"type": "integer", "minimum": 0}, "speakingSeconds": {"type": "integer", "minimum": 0}}}]},
    "part3": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "question": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": {"type": "string"},
        "questionNumber": {"type": "integer", "minimum": 1},
        "type": {"type": "string", "enum": ["multiple-choice-single", "mcq", "short-answer", "short", "tfng", "blanks", "matching", "rating"]},
        "prompt": {"type": "string"},
        "q": {"type": "string"},
        "options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "correctAnswer": {"type": ["string", "number", "boolean"]},
        "answer": {"type": ["string", "number", "boolean"]},
        "explanation": {"type": "string"},
        "category": {"type": "string"},
        "points": {"type": "number", "minimum": 0}
      },
      "anyOf": [
        {"required": ["prompt", "correctAnswer"]},
        {"required": ["q", "answer"]}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"section": {"const": "reading"}}}, "then": {"required": ["passages", "questions"]}},
    {"if": {"properties": {"section": {"const": "listening"}}}, "then": {"required": ["parts"]}},
    {"if": {"properties": {"section": {"const": "writing"}}}, "then": {"anyOf": [{"required": ["task1Prompt", "task2Prompt"]}, {"required": ["task1", "task2"]}]}},
    {"if": {"properties": {"section": {"const": "speaking"}}}, "then": {"anyOf": [{"required": ["speakingParts"]}, {"required": ["part1", "part2", "part3"]}]}}
  ]
}