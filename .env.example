# Local development
# Copy this file to .env and fill in your Supabase project values.
# SUPABASE_URL is safe to use as a public project URL, but the service-role key MUST remain server-side.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional AI configuration
GEMINI_API_KEY=

# Optional: custom writable database directory
# LINGOFI_DATA_DIR=
